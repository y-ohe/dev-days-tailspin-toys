---
import type { HTMLAttributes } from 'astro/types';

/** Public options for the styled panel and its root element. */
interface Props extends HTMLAttributes<'div'> {
    /** Semantic HTML element used for the panel. */
    as?: 'div' | 'section' | 'article' | 'aside';
}

const { as = 'div', class: className, ...rest } = Astro.props;
const Element = as;
---

<Element class:list={['bg-slate-800/70 backdrop-blur-sm border border-slate-700 rounded-xl', className]} {...rest}>
    <slot />
</Element>
