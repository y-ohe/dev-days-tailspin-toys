---
import { clampRating, formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
    showUnrated?: boolean;
}

const { rating, showUnrated = false } = Astro.props;
---

{(rating !== null || showUnrated) && (
    <div class="flex items-center">
        {rating === null ? (
            <span class="bg-blue-500/20 text-slate-300 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
                No rating yet
            </span>
        ) : (
            <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
                <span class="text-yellow-400">{formatStarRating(rating)}</span>
                {clampRating(rating).toFixed(1)}
            </span>
        )}
    </div>
)}
